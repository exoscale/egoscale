{{ .Doc }}
func (c Client) {{ .Name }}({{ .Params }}) {{ .Results }} {
	path := {{ .PathExpr }}

	{{ if .Body }}
	body, err := prepareJSONBody(req)
	if err != nil {
		return {{ .ErrReturn }}fmt.Errorf("{{ .Name }}: prepare JSON body: %w", err)
	}
	{{ end }}

	request, err := http.NewRequestWithContext(ctx, "{{ .Method }}", c.serverEndpoint + path, {{ if .Body }}body{{else}}nil{{end}})
	if err != nil {
		return {{ .ErrReturn }}fmt.Errorf("{{ .Name }}: new request: %w", err)
	}

	request.Header.Add("User-Agent", c.getUserAgent())

	{{ if .QueryOpts }}if len(opts) > 0 {
		q := request.URL.Query()
		for _, opt := range opts {
			opt(q)
		}
		request.URL.RawQuery = q.Encode()
	}{{ end }}

	{{ if .Body }}
	request.Header.Add("Content-Type", "application/json")
	{{ end }}

	if err := c.executeRequestInterceptors(ctx, request); err != nil {
		return {{ .ErrReturn }}fmt.Errorf("{{ .Name }}: execute request editors: %w", err)
	}

	{{ if not .SkipAuth }}
	if err := c.signRequest(request); err != nil {
		return {{ .ErrReturn }}fmt.Errorf("{{ .Name }}: sign request: %w", err)
	}
	{{ end }}

	if c.trace {
		dumpRequest(request, "{{ .OperationID }}")
	}

	response, err := c.httpClient.Do(request)
	if err != nil {
		return {{ .ErrReturn }}fmt.Errorf("{{ .Name }}: http client do: %w", err)
	}

	if c.trace {
		dumpResponse(response)
	}

	if err := handleHTTPErrorResp(response); err != nil {
		return {{ .ErrReturn }}fmt.Errorf("{{ .Name }}: http response: %w", {{ if .ErrorResponses }}decodeAPIErrorResponse(err, map[int]func() any{
			{{ range .ErrorResponses }}{{ .Code }}: func() any { return new({{ .Type }}) },
			{{ end }}}){{ else }}err{{ end }})
	}

	{{ if .Return -}}
	bodyresp := {{ .NewReturn }}
	if err := prepareJSONResponse(response, {{ .ReturnTarget }}); err != nil {
		return nil, fmt.Errorf("{{ .Name }}: prepare JSON response: %w", err)
	}

	return bodyresp, nil
	{{- else -}}
	_ = response.Body.Close()
	return nil
	{{- end }}
}
